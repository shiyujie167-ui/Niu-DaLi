# 生产环境变量参考模板 —— 复制为 .env 后，**必须替换所有 CHANGE_ME**。
#   cp deploy/.env.prod.example /srv/new-api/production/.env   # 再逐项替换占位符
#   （生产 .env 位于 /srv/new-api/production/.env，与编排文件 /srv/new-api/production/compose.yaml 同目录）
# 本文件只含键位与占位符，**不得写入任何真实密钥/真实 IP/真实 token**。
#
# 说明：
#   - APP_IMAGE 由 ops/deploy.sh 自动原子改写为 ghcr.io/shiyujie167-ui/niu-dali:sha-<完整40位sha>。
#   - 下面的 sha-<40hex> 是占位符，不要在首次部署前写死为某个真实 sha。
#   - GHCR 为 public：生产服务器无需任何 GitHub 凭据、无需 docker login。

# ---- 镜像与端口 ----
# 示例（发布时会被 deploy.sh 原子改写为真实 sha）：
APP_IMAGE=ghcr.io/shiyujie167-ui/niu-dali:sha-<40hex>
APP_PORT=3000

# ---- PostgreSQL ----
# 生产真实值：用户与库均为 newapi。
POSTGRES_USER=newapi
POSTGRES_DB=newapi
POSTGRES_PASSWORD=CHANGE_ME

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME

# ---- 会话与鉴权 ----
SESSION_SECRET=CHANGE_ME
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=

# ---- 反向代理 ----
TRUSTED_PROXIES=

# ---- 数据库连接池 ----
SQL_MAX_OPEN_CONNS=60
SQL_MAX_IDLE_CONNS=20

# ---- 站点与运行 ----
TZ=Asia/Shanghai
SYSTEM_NAME=大力牛
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
