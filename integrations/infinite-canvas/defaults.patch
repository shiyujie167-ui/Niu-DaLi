+import { afterAll, beforeAll, expect, test } from "bun:test";
+import { renderToStaticMarkup } from "react-dom/server";
+
+import { canvasThemes } from "../src/lib/canvas-theme";
+import type { AiConfig } from "../src/stores/use-config-store";
+import { installBrowserStorage } from "./helpers/browser-storage";
+
+let restoreStorage: () => void;
+let configModule: typeof import("../src/stores/use-config-store");
+let panelModule: typeof import("../src/components/video-settings-panel");
+let i18nModule: typeof import("../src/i18n");
+
+beforeAll(async () => {
+    restoreStorage = installBrowserStorage();
+    configModule = await import("../src/stores/use-config-store");
+    panelModule = await import("../src/components/video-settings-panel");
+    i18nModule = await import("../src/i18n");
+});
+
+afterAll(() => {
+    restoreStorage();
+});
+
+function renderSettings(model: string, options: { size?: string; resolution?: string; baseUrl?: string; script?: string } = {}) {
+    const config: AiConfig = {
+        ...structuredClone(configModule.defaultConfig),
+        model: `default::${model}`,
+        videoModel: `default::${model}`,
+        size: options.size || "16:9",
+        vquality: options.resolution || "720",
+        channels: [{
+            ...structuredClone(configModule.defaultConfig.channels[0]),
+            baseUrl: options.baseUrl || "https://8.216.57.93",
+            models: [{ name: model, capability: "video", script: options.script }],
+        }],
+    };
+    const changes: Array<[string, string]> = [];
+    const html = renderToStaticMarkup(<panelModule.VideoSettingsPanel config={config} theme={canvasThemes.light} onConfigChange={(key, value) => changes.push([key, value])} />);
+    const buttons = new Map(Array.from(html.matchAll(/<button\b([^>]*)>([\s\S]*?)<\/button>/g), (match) => [match[2].replace(/<[^>]*>/g, "").trim(), match[1]]));
+    const inputs = Array.from(html.matchAll(/<input\b([^>]*)>/g), (match) => match[1]);
+    return { html, buttons, inputs, changes };
+}
+
+test.each([
+    { model: "Sd-2.0fast", resolutions: ["720p", "1080p"], ratios: ["1:1", "3:4", "4:3", "16:9", "9:16", "21:9"] },
+    { model: "Sd-2.0满血933", resolutions: ["720p", "1080p", "4K"], ratios: ["1:1", "3:4", "4:3", "16:9", "9:16", "21:9"] },
+    { model: "Sd-2.5", resolutions: ["480p", "720p", "1080p"], ratios: ["1:1", "3:4", "4:3", "16:9", "9:16", "21:9"] },
+    { model: "minmax-h3", resolutions: ["768p", "2K"], ratios: ["1:1", "16:9", "9:16"] },
+])("$model disables every unsupported resolution and ratio", ({ model, resolutions, ratios }) => {
+    const view = renderSettings(model);
+    for (const label of ["480p", "720p", "768p", "1080p", "2K", "4K"]) {
+        expect(view.buttons.has(label)).toBe(true);
+        expect(/\bdisabled=""/.test(view.buttons.get(label)!)).toBe(!resolutions.includes(label));
+    }
+    for (const label of ["1:1", "3:4", "4:3", "16:9", "9:16", "21:9", i18nModule.default.t("settingsPanels.common.auto")]) {
+        expect(view.buttons.has(label)).toBe(true);
+        expect(/\bdisabled=""/.test(view.buttons.get(label)!)).toBe(!ratios.includes(label));
+    }
+    for (const label of ["W", "H", i18nModule.default.t("settingsPanels.video.quality")]) {
+        expect(view.inputs.find((input) => input.includes(`aria-label="${label}"`))).toContain('disabled=""');
+    }
+});
+
+test("switching to a model with unsupported saved settings shows an alert without changing the settings", () => {
+    const view = renderSettings("Sd-2.0fast", { resolution: "480", size: "3:4" });
+    expect(view.html).toContain('role="alert"');
+    expect(view.buttons.get("480p")).toContain('aria-pressed="true"');
+    expect(view.buttons.get("720p")).not.toContain('disabled=""');
+    expect(view.changes).toEqual([]);
+});
+
+test.each([
+    { model: "minmax-h3", resolution: "2k" },
+    { model: "Sd-2.0满血933", resolution: "4k" },
+])("$model keeps the $resolution tier without inventing pixel dimensions", ({ model, resolution }) => {
+    const view = renderSettings(model, { resolution });
+    expect(view.buttons.get(resolution.toUpperCase())).toContain('aria-pressed="true"');
+    for (const label of ["W", "H"]) {
+        const input = view.inputs.find((item) => item.includes(`aria-label="${label}"`));
+        expect(input).toContain('value=""');
+        expect(input).toContain('placeholder="—"');
+    }
+    expect(view.html).not.toContain('role="alert"');
+});
+
+test.each([
+    { baseUrl: "https://other-gateway.example" },
+    { baseUrl: "https://8.216.57.93", script: "return { url: 'fixture' };" },
+])("other providers and custom model scripts keep editable settings", (options) => {
+    const view = renderSettings("Sd-2.0fast", options);
+    expect(view.buttons.get("480p")).not.toContain('disabled=""');
+    expect(view.buttons.get(i18nModule.default.t("settingsPanels.common.auto"))).not.toContain('disabled=""');
+    expect(view.buttons.has("2K")).toBe(false);
+    for (const label of ["W", "H", i18nModule.default.t("settingsPanels.video.quality")]) {
+        const input = view.inputs.find((item) => item.includes(`aria-label="${label}"`));
+        expect(input).toBeDefined();
+        expect(input).not.toContain('disabled=""');
+    }
+    expect(view.html).not.toContain('role="alert"');
+});
