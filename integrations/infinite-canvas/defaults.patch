+    await videoModule.createVideoGenerationTask(config, "Frame scene", references);
+
+    expect(requests).toHaveLength(1);
+    expect(requests[0].url).toBe(`${baseUrl}/v1/videos`);
+    const body = requests[0].data as FormData;
+    expect(Object.fromEntries(Array.from(body).filter(([, value]) => typeof value === "string"))).toEqual({
