+++ b/web/src/lib/video-capabilities.ts
@@ -0,0 +1,40 @@
+import i18n from "@/i18n";
+import { computeVideoSize, inferVideoRatio, parseVideoResolution } from "@/lib/media-size";
+import { modelOptionName, resolveModelRequestConfig, resolveModelScript, type AiConfig } from "@/stores/use-config-store";
+
+const wideRatios = ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"];
+// Keep in sync with the gateway's mengwuxian task plugin model contract.
+const gatewayModels: Record<string, { resolutions: readonly string[]; ratios: readonly string[] }> = {
+    "Sd-2.0fast": { resolutions: ["720", "1080"], ratios: wideRatios },
+    "Sd-2.0满血933": { resolutions: ["720", "1080", "4k"], ratios: wideRatios },
+    "Sd-2.5": { resolutions: ["480", "720", "1080"], ratios: wideRatios },
+    "minmax-h3": { resolutions: ["768", "2k"], ratios: ["16:9", "9:16", "1:1"] },
+};
+
+export function getNiuVideoCapabilities(baseUrl: string, model: string) {
+    try {
+        if (new URL(baseUrl).origin !== "https://8.216.57.93") return undefined;
+    } catch {
+        return undefined;
+    }
+    const name = modelOptionName(model);
+    return Object.hasOwn(gatewayModels, name) ? gatewayModels[name] : undefined;
+}
+
+export function videoSettingsError(config: AiConfig): string {
+    const model = config.model || config.videoModel;
+    if (resolveModelScript(config, model)) return "";
+    const request = resolveModelRequestConfig(config, model);
+    const capabilities = request.apiFormat === "openai" ? getNiuVideoCapabilities(request.baseUrl, model) : undefined;
+    if (!capabilities) return "";
+    const rawResolution = config.vquality.trim().toLowerCase();
+    const resolution = parseVideoResolution(config.vquality);
+    const ratio = inferVideoRatio(config.size);
+    const supportedSize = capabilities.ratios.includes(config.size) || (capabilities.ratios.includes(ratio) && !resolution.endsWith("k") && computeVideoSize(resolution, ratio) === config.size);
+    if (/^(?:[1-9]\d*p?|[24]k|low|auto|high|medium)$/.test(rawResolution) && capabilities.resolutions.includes(resolution) && supportedSize) return "";
+    return i18n.t("apiErrors.unsupportedVideoSettings", {
+        model: modelOptionName(model),
+        resolutions: capabilities.resolutions.map((value) => value.endsWith("k") ? value.toUpperCase() : `${value}p`).join(" / "),
+        ratios: capabilities.ratios.join(" / "),
+    });
+}
