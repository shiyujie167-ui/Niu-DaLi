+
+test.each([
+    { model: "Sd-2.0fast", baseUrl: "https://8.216.57.93", status: "failed", errorMessage: undefined, proxyEnabled: false },
+    { model: "Sd-2.0满血933", baseUrl: "https://8.216.57.93/v1", status: "cancelled", errorMessage: "", proxyEnabled: false },
+    { model: "Sd-2.5", baseUrl: "https://8.216.57.93/", status: "failed", errorMessage: "{}", proxyEnabled: false },
+    { model: "minmax-h3", baseUrl: "https://8.216.57.93/v1/", status: "cancelled", errorMessage: "  ", proxyEnabled: true },
+])("gateway $model retrieves missing $status details from the native task without resubmitting", async ({ model, baseUrl, status, errorMessage, proxyEnabled }) => {
+    const defaults = configModule.defaultConfig;
+    const config: AiConfig = {
+        ...structuredClone(defaults),
+        proxyEnabled,
+        proxyUrl: "http://127.0.0.1:4999",
+        channels: [{ ...structuredClone(defaults.channels[0]), baseUrl, apiKey: "fixture-video-key" }],
+    };
+    configModule.useConfigStore.setState({ config });
+    const controller = new AbortController();
+    const task = { id: "fixture-public-task", provider: "openai" as const, model: `default::${model}` };
+    const prefix = proxyEnabled ? "http://127.0.0.1:4999/" : "";
+    const requests: InternalAxiosRequestConfig[] = [];
+    axios.defaults.adapter = async (request) => {
+        requests.push(request);
+        const data =
+            requests.length === 1
+                ? { id: task.id, status, error: { message: errorMessage }, video_url: "https://cdn.example/previous.mp4" }
+                : { task_id: task.id, status: "failed", error_message: '{"detail":"MATERIAL_LIMIT_EXCEEDED: reference unavailable"}' };
+        return { data, status: 200, statusText: "OK", headers: {}, config: request };
