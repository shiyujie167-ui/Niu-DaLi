+    expect(state).toEqual({ status: "failed", error: "MATERIAL_LIMIT_EXCEEDED: reference unavailable" });
+    expect(requests.map((request) => [request.method, request.url])).toEqual([
+        ["get", `${prefix}https://8.216.57.93/v1/videos/${task.id}`],
+        ["get", `${prefix}https://8.216.57.93/mengwuxian/api/v1/video-tasks/${task.id}`],
+    ]);
+    for (const request of requests) {
+        expect(request.headers.get("Authorization")).toBe("Bearer fixture-video-key");
+        expect(request.signal).toBe(controller.signal);
+    }
+});
+
+test("gateway task failure with readable detail skips the native query", async () => {
+    const defaults = configModule.defaultConfig;
+    const config: AiConfig = {
+        ...structuredClone(defaults),
+        channels: [{ ...structuredClone(defaults.channels[0]), apiKey: "fixture-video-key" }],
+    };
+    const requests: InternalAxiosRequestConfig[] = [];
+    axios.defaults.adapter = async (request) => {
+        requests.push(request);
+        return { data: { id: "fixture-task", status: "failed", error: { message: '{"detail":"Provider capacity exhausted"}' } }, status: 200, statusText: "OK", headers: {}, config: request };
+    };
+
+    const state = await videoModule.pollVideoGenerationTask(config, { id: "fixture-task", provider: "openai", model: config.videoModel });
+
+    expect(state).toEqual({ status: "failed", error: "Provider capacity exhausted" });
+    expect(requests.map((request) => [request.method, request.url])).toEqual([["get", "https://8.216.57.93/v1/videos/fixture-task"]]);
+});
+
+test.each(["missing detail", "query failure"])("native %s preserves the failed task and generic message", async (caseName) => {
+    const defaults = configModule.defaultConfig;
+    const config: AiConfig = {
+        ...structuredClone(defaults),
+        channels: [{ ...structuredClone(defaults.channels[0]), apiKey: "fixture-video-key" }],
+    };
+    const requests: InternalAxiosRequestConfig[] = [];
+    axios.defaults.adapter = async (request) => {
+        requests.push(request);
+        if (requests.length === 2 && caseName === "query failure") throw new Error("Native task query unavailable");
+        const data = requests.length === 1 ? { id: "fixture-task", status: "failed" } : { task_id: "fixture-task", status: "failed", error_message: "  " };
+        return { data, status: 200, statusText: "OK", headers: {}, config: request };
+    };
+
+    const state = await videoModule.pollVideoGenerationTask(config, { id: "fixture-task", provider: "openai", model: config.videoModel });
+
+    expect(state).toEqual({ status: "failed", error: i18nModule.default.t("apiErrors.videoGenerationFailed") });
+    expect(requests.map((request) => request.method)).toEqual(["get", "get"]);
+});
+
+test.each([
+    { baseUrl: "https://other-gateway.example", model: "Sd-2.0fast" },
+    { baseUrl: "http://8.216.57.93", model: "Sd-2.0fast" },
+    { baseUrl: "https://8.216.57.93:8443", model: "Sd-2.0fast" },
+    { baseUrl: "https://8.216.57.93", model: "other-video-model" },
+])("failed $model at $baseUrl does not call the native gateway query", async ({ baseUrl, model }) => {
+    const defaults = configModule.defaultConfig;
+    const selectedModel = `default::${model}`;
+    const config: AiConfig = {
+        ...structuredClone(defaults),
+        channels: [{ ...structuredClone(defaults.channels[0]), baseUrl, apiKey: "fixture-video-key", models: [{ name: model, capability: "video" }] }],
+    };
+    const requests: InternalAxiosRequestConfig[] = [];
+    axios.defaults.adapter = async (request) => {
+        requests.push(request);
+        return { data: { id: "fixture-task", status: "failed" }, status: 200, statusText: "OK", headers: {}, config: request };
+    };
+
+    const state = await videoModule.pollVideoGenerationTask(config, { id: "fixture-task", provider: "openai", model: selectedModel });
+
+    expect(state).toEqual({ status: "failed", error: i18nModule.default.t("apiErrors.videoGenerationFailed") });
+    expect(requests.map((request) => [request.method, request.url])).toEqual([["get", `${baseUrl}/v1/videos/fixture-task`]]);
+});
+
+test.each(["axios cancellation", "aborted signal", "abort error"])("native detail lookup propagates %s", async (caseName) => {
+    const defaults = configModule.defaultConfig;
+    const config: AiConfig = {
+        ...structuredClone(defaults),
+        channels: [{ ...structuredClone(defaults.channels[0]), apiKey: "fixture-video-key" }],
+    };
+    const controller = new AbortController();
+    const cancelled = caseName === "abort error" ? new DOMException("Aborted", "AbortError") : new axios.CanceledError("Fixture cancelled");
+    const requests: InternalAxiosRequestConfig[] = [];
+    axios.defaults.adapter = async (request) => {
+        requests.push(request);
+        if (requests.length === 2) {
+            if (caseName === "aborted signal") controller.abort();
+            throw cancelled;
+        }
+        return { data: { id: "fixture-task", status: "failed" }, status: 200, statusText: "OK", headers: {}, config: request };
+    };
+
+    await expect(videoModule.pollVideoGenerationTask(config, { id: "fixture-task", provider: "openai", model: config.videoModel }, { signal: controller.signal })).rejects.toBe(cancelled);
+    expect(requests.map((request) => request.method)).toEqual(["get", "get"]);
+});
