@@ -0,0 +1,105 @@
+import { afterAll, afterEach, beforeAll, beforeEach, expect, test } from "bun:test";
+import axios from "axios";
+
+import type { AiConfig } from "../src/stores/use-config-store";
+import { installBrowserStorage } from "./helpers/browser-storage";
+
+let restoreStorage: () => void;
+const originalAdapter = axios.defaults.adapter;
+let getNiuVideoCapabilities: typeof import("../src/lib/video-capabilities").getNiuVideoCapabilities;
+let videoSettingsError: typeof import("../src/lib/video-capabilities").videoSettingsError;
+let computeVideoSize: typeof import("../src/lib/media-size").computeVideoSize;
+let parseVideoResolution: typeof import("../src/lib/media-size").parseVideoResolution;
+let defaultConfig: AiConfig;
+let createVideoGenerationTask: typeof import("../src/services/api/video").createVideoGenerationTask;
+
+beforeAll(async () => {
+    restoreStorage = installBrowserStorage();
+    ({ getNiuVideoCapabilities, videoSettingsError } = await import("../src/lib/video-capabilities"));
+    ({ computeVideoSize, parseVideoResolution } = await import("../src/lib/media-size"));
+    ({ defaultConfig } = await import("../src/stores/use-config-store"));
+    ({ createVideoGenerationTask } = await import("../src/services/api/video"));
+});
+beforeEach(() => { axios.defaults.adapter = async () => { throw new Error("Unexpected offline request"); }; });
+afterEach(() => { axios.defaults.adapter = originalAdapter; });
+afterAll(() => {
+    restoreStorage();
+});
+
+function videoConfig(model: string, resolution: string, size = "16:9"): AiConfig {
+    return { ...structuredClone(defaultConfig), model: `default::${model}`, videoModel: `default::${model}`, vquality: resolution, size, channels: [{ ...structuredClone(defaultConfig.channels[0]), apiKey: "fixture-key" }] };
+}
+
+test.each([
+    ["Sd-2.0fast", ["720", "1080"]],
+    ["Sd-2.0满血933", ["720", "1080", "4k"]],
+    ["Sd-2.5", ["480", "720", "1080"]],
+    ["minmax-h3", ["768", "2k"]],
+] as const)("%s exposes only its supported resolutions", (model, resolutions) => {
+    expect(getNiuVideoCapabilities("https://8.216.57.93/v1", model)?.resolutions).toEqual(resolutions);
+});
+
+test("capabilities are scoped to the gateway and known models", () => {
+    expect(getNiuVideoCapabilities("https://other.example", "Sd-2.0fast")).toBeUndefined();
+    expect(getNiuVideoCapabilities("https://8.216.57.93", "custom")).toBeUndefined();
+    expect(getNiuVideoCapabilities("invalid", "Sd-2.0fast")).toBeUndefined();
+    expect(getNiuVideoCapabilities("https://8.216.57.93", "minmax-h3")?.ratios).toEqual(["16:9", "9:16", "1:1"]);
+});
+
+test.each([
+    ["Sd-2.0fast", "480", "16:9"],
+    ["minmax-h3", "720", "16:9"],
+    ["minmax-h3", "768", "21:9"],
+    ["Sd-2.5", "720", "auto"],
+    ["Sd-2.5", "720", "1000x720"],
+    ["Sd-2.0fast", "garbage", "16:9"],
+] as const)("%s rejects unsupported %s / %s before creating a task", async (model, resolution, size) => {
+    const config = videoConfig(model, resolution, size);
+    expect(videoSettingsError(config)).not.toBe("");
+    await expect(createVideoGenerationTask(config, "Offline validation")).rejects.toThrow(videoSettingsError(config));
+});
+
+test.each([
+    ["Sd-2.5", "480", "16:9"],
+    ["Sd-2.0fast", "1080", "1920x1080"],
+    ["minmax-h3", "768", "1366x768"],
+    ["minmax-h3", "2k", "9:16"],
+    ["Sd-2.0满血933", "4k", "21:9"],
+] as const)("%s accepts supported %s / %s", (model, resolution, size) => {
+    expect(videoSettingsError(videoConfig(model, resolution, size))).toBe("");
+});
+
+test("custom scripts keep control of their own settings", () => {
+    const config = videoConfig("Sd-2.0fast", "480", "auto");
+    config.channels[0].models = [{ name: "Sd-2.0fast", capability: "video", script: "return {url: 'https://example.com/video.mp4'}" }];
+    expect(videoSettingsError(config)).toBe("");
+});
+
+test.each([["minmax-h3", "2k"], ["Sd-2.0满血933", "4k"]] as const)("%s sends the literal %s resolution without inventing pixels", async (model, resolution) => {
+    expect(parseVideoResolution(resolution)).toBe(resolution);
+    expect(computeVideoSize(resolution, "16:9")).toBe("auto");
+    const requests: FormData[] = [];
+    const originalAdapter = axios.defaults.adapter;
+    axios.defaults.adapter = async (config) => {
+        requests.push(config.data as FormData);
+        return { data: { id: "offline-task" }, status: 200, statusText: "OK", headers: {}, config };
+    };
+    try {
+        await createVideoGenerationTask(videoConfig(model, resolution), "Offline wire format");
+        expect(requests).toHaveLength(1);
+        expect(requests[0].get("resolution")).toBe(resolution);
+        expect(requests[0].get("aspect_ratio")).toBe("16:9");
+    } finally {
+        axios.defaults.adapter = originalAdapter;
+    }
+});
+
+test("gateway validation and requests normalize spaced K tiers consistently", async () => {
+    const config = videoConfig("minmax-h3", " 2K ");
+    expect(videoSettingsError(config)).toBe("");
+    axios.defaults.adapter = async (request) => {
+        expect((request.data as FormData).get("resolution")).toBe("2k");
+        return { data: { id: "offline-task" }, status: 200, statusText: "OK", headers: {}, config: request };
+    };
+    await createVideoGenerationTask(config, "Offline normalization");
+});
