+// 88API official and cloud contracts, verified 2026-10-12.
+// Exact model IDs only: similarly named models at other providers are unrelated.
+export type SeedanceCapabilities = {
+    resolutions: readonly string[];
+    ratios: readonly string[];
+    maxSeconds: number;
+    maxImages: number;
+    maxVideos: number;
+    maxAudios: number;
+    maxMedia?: number;
+    frames: boolean;
+    generateAudio: boolean;
+};
+const ratios = ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9"];
+const standard: SeedanceCapabilities = { resolutions: ["720"], ratios, maxSeconds: 15, maxImages: 9, maxVideos: 3, maxAudios: 3, frames: true, generateAudio: false };
+const capabilities: Record<string, SeedanceCapabilities> = {
+    "seedance-2.5官方版": { ...standard, maxSeconds: 30, maxImages: 30, maxVideos: 10, maxAudios: 10 },
+    "seedance-2.0官方版": standard,
+    "seedance-2.0-fast官方版": standard,
+    "seedance-2.0-mini官方版": { ...standard, resolutions: ["480", "720"], frames: false },
+    "SD2.0": { ...standard, resolutions: ["480", "720", "1080", "4k"], maxMedia: 12 },
+    "SD2.5": { ...standard, resolutions: ["480", "720", "1080"], maxSeconds: 30, maxImages: 30, maxVideos: 10, maxAudios: 10, generateAudio: true },
+};
+for (const model of ["SD2.0", "SD2.5"]) {
+    for (const resolution of capabilities[model].resolutions) {
+        const suffix = resolution.endsWith("k") ? resolution.toUpperCase() : `${resolution}P`;
+        capabilities[`${model} ${suffix}`] = { ...capabilities[model], resolutions: [resolution] };
+    }
+}
+export function getSeedanceCapabilities(model: string): SeedanceCapabilities | undefined {
+    return Object.hasOwn(capabilities, model) ? capabilities[model] : undefined;
+}
+export const seedanceDefaultPrompt = "保持参考素材中的主体外观和风格，生成自然连贯的动作与镜头";
+
+
+export function isDirect88Api(baseUrl: string): boolean {
+    try {
+        const url = new URL(baseUrl);
+        return url.origin === "https://api.88api.ai" && !url.username && !url.password && !url.search && !url.hash && ["", "/v1"].includes(url.pathname.replace(/\/+$/, ""));
+    } catch {
+        return false;
+    }
+}
+
+export function usesSeedanceAdapter(config: { baseUrl: string; videoAdapter?: "88api" }): boolean {
+    return config.videoAdapter === "88api" || isDirect88Api(config.baseUrl);
+}
