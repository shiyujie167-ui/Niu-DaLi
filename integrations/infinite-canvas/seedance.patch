+import axios from "axios";
+import { getSeedanceCapabilities, isDirect88Api, seedanceDefaultPrompt } from "@/lib/seedance-capabilities";
+import { inferVideoRatio, parseVideoResolution } from "@/lib/media-size";
+import { buildApiUrl, boolConfig, type AiConfig } from "@/stores/use-config-store";
+
+// Signed asset PUTs never use gateway authorization defaults/interceptors.
+type MediaTicket = { url: string; upload_url: string; method: string; headers: Record<string, string>; expires_at: number };
+
+export async function createSeedanceTask(config: AiConfig, model: string, prompt: string, images: File[], videos: File[], audios: File[], signal?: AbortSignal): Promise<string> {
+    const caps = getSeedanceCapabilities(model);
+    if (!caps) throw new Error("不支持的 Seedance 模型");
+    const seconds = Number(config.videoSeconds || "4");
+    if (!Number.isInteger(seconds) || seconds < 4 || seconds > caps.maxSeconds) throw new Error(`当前模型支持 4–${caps.maxSeconds} 秒，请调整时长`);
+    const resolution = parseVideoResolution(config.vquality);
+    if (!caps.resolutions.includes(resolution)) throw new Error(`当前模型支持 ${caps.resolutions.map(v => v.endsWith("k") ? v : `${v}p`).join(" / ")}，请选择对应分辨率`);
+    const ratio = inferVideoRatio(config.size);
+    if (!caps.ratios.includes(ratio)) throw new Error("请选择明确的视频比例，不支持自动比例");
+    const frames = config.videoMode === "frames";
+    if (frames && (!caps.frames || images.length < 1 || images.length > 2 || videos.length || audios.length)) throw new Error("首尾帧模式需要一张首帧或两张首尾帧图片，不能混用音视频；mini 不支持首尾帧");
+    if (images.length > caps.maxImages || videos.length > caps.maxVideos || audios.length > caps.maxAudios || (caps.maxMedia && images.length + videos.length + audios.length > caps.maxMedia)) throw new Error(`参考素材超出模型上限：图片 ${caps.maxImages}、视频 ${caps.maxVideos}、音频 ${caps.maxAudios}${caps.maxMedia ? `，合计 ${caps.maxMedia}` : ""}`);
+    const text = prompt.trim() || (images.length + videos.length + audios.length ? seedanceDefaultPrompt : "");
+    if (!text) throw new Error("请填写提示词或连接参考素材");
+    // Validate the complete set before requesting any upload tickets.
+    for (const [files, types] of [[images, ["image/png", "image/jpeg", "image/webp"]], [videos, ["video/mp4", "video/webm", "video/quicktime"]], [audios, ["audio/mpeg", "audio/wav", "audio/ogg", "audio/mp4", "audio/flac"]]] as const) {
+        for (const file of files) {
+            if (!types.some(type => type === file.type) || !file.size || file.size > 100000000) throw new Error("素材格式不支持或文件超过上传接口的 100 MB 上限");
+            if (file.type.startsWith("image/") && file.size > 10 * 1024 * 1024) throw new Error("参考图片不能超过 10 MiB");
+        }
+    }
+    const metadata: Record<string, unknown> = {};
+    const body: Record<string, unknown> = { model, prompt: text, duration: seconds, resolution: resolution.endsWith("k") ? resolution : `${resolution}p`, ratio };
+    const imageUrls: string[] = [];
+    for (const image of images) imageUrls.push(await uploadSeedanceMedia(config, model, image, signal));
+    if (frames) {
+        metadata.firstFrame = imageUrls[0];
+        if (imageUrls[1]) metadata.lastFrame = imageUrls[1];
+    } else if (imageUrls.length) body.images = imageUrls;
+    for (const [key, files] of [["referenceVideos", videos], ["referenceAudios", audios]] as const) {
+        const urls: string[] = [];
+        for (const file of files) urls.push(await uploadSeedanceMedia(config, model, file, signal));
+        if (urls.length) metadata[key] = urls;
+    }
+    if (Object.keys(metadata).length) body.metadata = metadata;
+    if (caps.generateAudio) body.generate_audio = boolConfig(config.videoGenerateAudio, true);
+    const response = await axios.post<{ id?: string }>(buildApiUrl(config.baseUrl, "/videos"), body, { headers: { Authorization: `Bearer ${config.apiKey}` }, signal });
+    if (typeof response.data.id !== "string" || !response.data.id.trim()) throw new Error("网关未返回任务 ID，请先核对任务记录，不要重复提交");
+    return response.data.id;
+}
+
+export async function uploadSeedanceMedia(config: AiConfig, model: string, file: File, signal?: AbortSignal): Promise<string> {
+    const digest = new Uint8Array(await crypto.subtle.digest("SHA-256", await file.arrayBuffer()));
+    const sha256 = btoa(String.fromCharCode(...digest)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+    const uploadRequest = { size: file.size, mime_type: file.type, sha256, ...(isDirect88Api(config.baseUrl) ? {} : { model }) };
+    const ticket = (await axios.post<MediaTicket>(buildApiUrl(config.baseUrl, "/media/uploads"), uploadRequest, { headers: { Authorization: `Bearer ${config.apiKey}` }, signal })).data;
+    for (const value of [ticket.url, ticket.upload_url]) {
+        const url = new URL(value);
+        if (url.origin !== "https://assets.88api.ai" || url.username || url.password || url.hash || !url.pathname.startsWith("/media/reference-media/")) throw new Error("素材上传凭证地址无效");
+    }
+    const headers = new Headers(ticket.headers);
+    if (ticket.method !== "PUT" || !Number.isSafeInteger(ticket.expires_at) || ticket.expires_at * 1000 <= Date.now() || [...headers].length !== 2 || headers.get("content-type") !== file.type || !headers.get("x-media-upload-token")) throw new Error("素材上传凭证无效或已过期");
+    const uploaded = await fetch(ticket.upload_url, { method: "PUT", body: file, headers: { "Content-Type": file.type, "X-Media-Upload-Token": headers.get("x-media-upload-token")! }, signal, redirect: "error", credentials: "omit" });
+    if (uploaded.status !== 201) throw new Error("素材上传未完成，未提交生成任务");
+    return ticket.url;
+}
